# ==============================================================================
# Modern Product Slider SaaS - Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5001
NODE_ENV=production
FRONTEND_URL="https://modern-product-slider.vercel.app"

# ==============================================================================
# Safepay Payment Gateway Credentials (https://getsafepay.com)
# ==============================================================================
# Set to 'sandbox' for testing, 'production' for live payments
SAFEPAY_ENVIRONMENT="sandbox"

# Safepay Merchant API Key (Public key provided in your Safepay Dashboard > Developers)
# Sandbox keys typically begin with "sec_"
SAFEPAY_API_KEY="sec_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Safepay Shared Secret Key (Private key used for server-to-server signature authorization)
SAFEPAY_V1_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Safepay Webhook Secret (Provided when you register your webhook URL in Safepay Dashboard)
# Webhook URL to register: https://your-backend.railway.app/api/v1/payments/webhook
SAFEPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==============================================================================
# Database Connection (Choose Supabase, Neon, standard PostgreSQL, or MongoDB)
# Leave blank to use built-in local persistent JSON database (data/saas_db.json)
# ==============================================================================
# DATABASE_URL="postgresql://postgres:password@localhost:5432/modern_slider?sslmode=require"
# MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/modern_slider"

# Admin Access Credentials
ADMIN_EMAIL="admin@modernproductslider.com"
ADMIN_PASSWORD="Admin@MPS2026!"
ADMIN_SECRET="mps_superadmin_secret_2026"

# Resend Email SMTP (For live Gmail 6-digit OTP delivery)
# RESEND_API_KEY=""
# SMTP_FROM="Modern Product Slider <onboarding@resend.dev>"

# Google OAuth Client (Optional - client-side Google Identity Services button)
VITE_GOOGLE_CLIENT_ID=""
