# Copy to .env.local for local dev. On Vercel, add the same keys in
# Project Settings -> Environment Variables (Production).
# Never commit real secrets to Git.

# Required for real (shared) data. Without these, the API runs in demo
# mode with in-memory seed data that does not persist.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# The admin account is the first user who signs up with this email.
ADMIN_EMAIL=chabubakar78690@gmail.com

# Public site URL (used for OAuth redirects + PayFast return URLs).
NEXT_PUBLIC_SITE_URL=https://modern-product-slider.vercel.app

# Optional: Google / Facebook OAuth (also editable in Admin > Settings).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
